# 宿主机模型目录（GGUF 文件所在目录）
HOST_MODEL_DIR=E:\MODEL\Tencent-Hunyuan\HY-MT1___5-1___8B-GGUF

# 默认使用 Q4_K_M 版本
GGUF_MODEL_FILE=HY-MT1.5-1.8B-Q4_K_M.gguf
# mac 原生模式可直接指定本机模型绝对路径；Docker 模式可保持为空
MODEL_FILE=

# 推理后端：Docker CPU 版保持 cpu；mac 原生 Metal 版改为 metal
LLAMA_BACKEND=cpu
# 使用 GPU 的层数。CPU 模式建议 0；mac Metal 模式建议 -1（全部可上 GPU 的层）
LLAMA_N_GPU_LAYERS=0
# 多 GPU 场景主 GPU 序号，Apple Metal 通常保持 0
LLAMA_MAIN_GPU=0

# 线程数，默认为 4，根据实际 CPU 核数调整，过多可能导致性能下降
LLAMA_THREADS=4
# 进程数，默认为 1，根据实际 CPU 核数调整，过多可能导致性能下降
UVICORN_WORKERS=1
# 最大上下文长度，单位为 token，默认为 2048
LLAMA_CTX_SIZE=2048
LLAMA_PARALLEL=1
MAX_NEW_TOKENS=256

# 可选：接口鉴权，留空表示不启用
APIKEY=QWERTYUIOP
