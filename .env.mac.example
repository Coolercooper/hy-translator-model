# mac 原生 Metal 模式：直接指向本机 GGUF 模型绝对路径
MODEL_FILE=/absolute/path/to/HY-MT1.5-1.8B-Q4_K_M.gguf

# 启用 Apple Metal GPU
LLAMA_BACKEND=metal
# -1 表示尽可能将可支持的层放到 GPU
LLAMA_N_GPU_LAYERS=-1
# Apple Metal 单 GPU 场景通常保持 0
LLAMA_MAIN_GPU=0

# 建议单进程，避免重复加载模型
LLAMA_THREADS=4
UVICORN_WORKERS=1
LLAMA_CTX_SIZE=2048
LLAMA_PARALLEL=1
MAX_NEW_TOKENS=256

# 可选：接口鉴权，留空表示不启用
APIKEY=QWERTYUIOP

# 可选：服务监听地址
HOST=0.0.0.0
PORT=8000